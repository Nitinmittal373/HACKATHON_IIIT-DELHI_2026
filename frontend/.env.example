# Address of the NeevCheck backend. Used from Phase 4, when search and checks
# start calling the API; the home page fetches nothing.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public address of this site, used for share previews (Vercel: your production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sign in with Google (Auth.js). Leave empty to run without accounts: checking a project never
# needs one. Redirect URIs to allow in Google Cloud:
#   http://localhost:3000/api/auth/callback/google
#   https://neevcheck-up.vercel.app/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Shared with the API (AUTH_BRIDGE_SECRET on Render): signs the 10-minute token for saved reports
AUTH_BRIDGE_SECRET=
