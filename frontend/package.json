{
  "name": "neevcheck-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "capture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture.ts",
    "capture:live": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-live.ts",
    "gen:api": "openapi-typescript ../contracts/openapi.json -o src/lib/api-schema.d.ts --default-non-nullable false",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "next": "15.5.28",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "gifenc": "1.0.3",
    "openapi-typescript": "7.13.0",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
