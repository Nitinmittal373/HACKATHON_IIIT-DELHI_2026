# Copy this file to .env and fill in your own values. Never commit .env.
TINYFISH_API_KEY=

# true = replay cached agent runs instead of spending credits (use for the stage demo)
DEMO_MODE=false

# Max TinyFish agent runs at the same time (pay-as-you-go accounts allow 2)
AGENT_CONCURRENCY=2

# Public HTTPS URL of this backend, needed only for Watch mode webhooks (e.g. from ngrok or Render)
PUBLIC_BASE_URL=
