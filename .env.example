# TinyFish key from https://agent.tinyfish.ai (never commit the real .env)
TINYFISH_API_KEY=

# true = replay saved runs only (stage demo backup)
DEMO_MODE=false
# Web agents running at once (pay-as-you-go limit is 2)
AGENT_CONCURRENCY=2

# Frontend address(es) allowed to call the API
FRONTEND_ORIGINS=http://localhost:3000
# New checks per minute per IP
RATE_LIMIT_PER_MINUTE=6

# Watch mode: public https address of this backend (e.g. ngrok) and a long random secret
PUBLIC_BASE_URL=
WEBHOOK_SECRET=
