# Copy this file to `.env` in the repo root and fill in your own values.
# `.env` is listed in .gitignore, so your real key never reaches GitHub.

# ---------- TinyFish ----------
# Get a key at https://agent.tinyfish.ai
TINYFISH_API_KEY=

# true  = no key needed: the app replays a recorded real check (good for demos)
# false = live checks with TinyFish agents
DEMO_MODE=true

# Browser agents allowed to run at the same time (pay-as-you-go plan allows 2)
AGENT_CONCURRENCY=2

# ---------- Backend ----------
# Frontend address(es) allowed to call the API, comma separated
FRONTEND_ORIGINS=http://localhost:3000
# New checks allowed per minute from one IP address
RATE_LIMIT_PER_MINUTE=6

# ---------- Neev Sentinel (optional) ----------
# Public https address of this backend, so TinyFish monitors can call our webhook
PUBLIC_BASE_URL=
# Long random string; the webhook rejects calls without it
WEBHOOK_SECRET=
