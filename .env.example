# Copy this file to `.env` in the repo root and fill in your own values.
# `.env` is listed in .gitignore, so your real key never reaches GitHub.

# ---------- TinyFish ----------
# Required: every check reads live records. Get a key at https://agent.tinyfish.ai/api-keys
# (A TINYFISH_API_KEY set in your shell takes precedence over this file.)
TINYFISH_API_KEY=

# Browser agents allowed to run at the same time (pay-as-you-go plan allows 2)
AGENT_CONCURRENCY=2
# Longest one agent may run, in seconds. Every run is capped by this.
AGENT_TIMEOUT_SECONDS=300
# Send a step limit with each run. TinyFish accepts one only on beta accounts,
# so leave this false unless yours is enabled.
AGENT_SEND_MAX_STEPS=false

# ---------- Backend ----------
# Frontend address(es) allowed to call the API, comma separated
FRONTEND_ORIGINS=http://localhost:3000
# New checks allowed per minute from one IP address
RATE_LIMIT_PER_MINUTE=6
# Optional: defaults to SQLite in backend/data/neevcheck.db
# (Postgres works too: set a postgresql:// URL and install its driver, such as psycopg)
# DATABASE_URL=sqlite:////absolute/path/to/neevcheck.db

# ---------- Credit protection ----------
# Every live check and search spends TinyFish credit. These limits keep the bill small.
# Days and months are counted in Indian time.
# A new live check needs a sign-in (reading and reusing saved reports never does)
REQUIRE_SIGNIN_FOR_CHECKS=true
CHECKS_PER_ACCOUNT_PER_DAY=2
# Live checks the whole site may start (Sentinel's re-checks included)
SITE_CHECKS_PER_DAY=5
SITE_CHECKS_PER_MONTH=60
# A report finished this many days ago is shown again instead of checking again
REUSE_REPORT_DAYS=7
# "Re-check now" works once per project in this many days
RECHECK_MIN_DAYS=7
# Search answers are kept this many days; a kept answer costs nothing
SEARCH_CACHE_DAYS=7
SEARCHES_PER_IP_PER_DAY=15
SEARCHES_PER_IP_PER_DAY_SIGNED_IN=40
# Searches that really run across the whole site per day (a saved answer never counts)
SITE_SEARCHES_PER_DAY=200
# When true, only the signed-in e-mails in ALLOWED_EMAILS (comma separated) may start checks
INVITE_ONLY=false
ALLOWED_EMAILS=
# Secret for GET /api/admin/usage (sent as the X-Admin-Token header); empty turns the route off
ADMIN_TOKEN=
# UP-RERA numbers (comma separated) for the home page gallery. Only projects with a saved
# check are shown.
FEATURED_RERA_IDS=

# ---------- Neev Sentinel (optional) ----------
# A watched project is re-checked when its last check is older than this many hours; 0 turns
# the built-in schedule off. There is no timer: the API looks at startup and on requests,
# at most once an hour.
SENTINEL_INTERVAL_HOURS=168
# Re-checks the built-in schedule may start per day (each is a paid live check, and it also
# stops when SITE_CHECKS_PER_DAY or SITE_CHECKS_PER_MONTH is used up)
SENTINEL_CHECKS_PER_DAY=1
# Long random string; POST /api/sentinel/run (for an external cron) needs it as the
# X-Webhook-Secret header. With none set that endpoint refuses every call.
WEBHOOK_SECRET=
# Optional email for alerts. Without an email setup alerts are only shown on the Alerts page,
# and the site stops mentioning email.
# Preferred: an HTTPS email API. EMAIL_PROVIDER is brevo or resend; EMAIL_FROM must be a
# sender the provider has verified (for example "NeevCheck <you@example.com>").
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_FROM=
# Fallback: SMTP (some hosts block SMTP ports, which is why the API above is preferred).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The web app's public address (for example https://neevcheck-up.vercel.app). Every alert
# email ends with a link to <this>/alerts/stop; without it the link is left out.
SITE_URL=

# ---------- TinyFish Monitors (off by default) ----------
# Monitors bill on their own clock, outside the site budget above. While this is false no
# monitor is created, and any monitor made earlier for a current watch is cancelled at startup.
SENTINEL_MONITORS=false
# Only used when SENTINEL_MONITORS=true. This API's public address (for example
# https://neevcheck-api.onrender.com); with WEBHOOK_SECRET it lets monitors call
# POST /api/sentinel/webhook.
PUBLIC_BASE_URL=

# ---------- Accounts (optional) ----------
# Same value as the web app's AUTH_BRIDGE_SECRET; lets signed-in visitors save reports
AUTH_BRIDGE_SECRET=
